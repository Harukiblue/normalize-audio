{
  "name": "sermon-audio-cleaner",
  "version": "0.1.0",
  "description": "A private, automatic sermon audio cleaner powered by deterministic FFmpeg filters.",
  "license": "GPL-3.0-or-later",
  "author": "Sermon Audio Cleaner contributors",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "dist:mac:x64": "pnpm build && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "pnpm build && electron-builder --mac dmg --arm64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.0",
    "cross-env": "10.0.0",
    "electron": "37.2.6",
    "electron-builder": "26.11.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.1",
    "vitest": "3.2.4",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "org.sermonaudiocleaner.app",
    "productName": "Sermon Audio Cleaner",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@derhuerst/ffprobe-static/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    }
  },
  "packageManager": "pnpm@11.19.0"
}
